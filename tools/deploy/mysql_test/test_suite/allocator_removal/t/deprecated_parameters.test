# owner: wangyunlai.wyl
# owner group: storage
# tags: allocator

SELECT COUNT(DISTINCT name) = 7 AS retired_parameters_loadable
FROM oceanbase.__all_virtual_sys_parameter_stat
WHERE name IN ('cache_wash_threshold', 'memory_chunk_cache_size',
               '__min_full_resource_pool_memory',
               '_min_malloc_sample_interval', '_max_malloc_sample_interval',
               '_ctx_memory_limit', '_enable_memleak_light_backtrace');
